# ── TTS Provider ─────────────────────────────────────────────
# "cit" = CIT Voice Studio (local; alias cũ "vieneu") | "edge" = Edge TTS (miễn phí) | "vbee" = Vbee TTS (cần tài khoản)
TTS_PROVIDER=edge

# ── CIT Voice Studio / VieNeu TTS (TTS_PROVIDER=cit) ────────
# Nhận cả tên mới CIT_TTS_* và tên cũ VIENEU_*; nếu khai báo cả hai, CIT_TTS_* thắng.
# API endpoint của CIT Voice Studio / VieNeu-TTS
VIENEU_API_URL=http://127.0.0.1:8001
# Giọng đọc: Minh Đức, Phạm Tuyên, Thái Sơn, Xuân Vĩnh, Thanh Bình, Trúc Ly, Mai Anh... (xem vieneu.md hoặc GET /voices)
VIENEU_VOICE=Minh Đức
# Tốc độ đọc (1.0 = mặc định; cũng nhận CIT_TTS_SPEED)
VIENEU_SPEED=1.0

# ── Edge TTS (chỉ cần khi TTS_PROVIDER=edge) ────────────────
# vi-VN-NamMinhNeural (nam) | vi-VN-HoaiMyNeural (nữ)
# Cũng nhận EDGE_TTS_VOICE / EDGE_TTS_RATE
EDGE_VOICE=vi-VN-NamMinhNeural

# ── Vbee TTS (chỉ cần khi TTS_PROVIDER=vbee) ────────────────
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Giọng đọc Vbee — danh sách khác xem vbee.md hoặc trên trang chủ vbee § 5
VBEE_VOICE_CODE=
# Tuỳ chọn: URL callback (mặc định https://example.com/callback)
# VBEE_CALLBACK_URL=



# ── Video series ─────────────────────────────────────────────
# Tên kênh hiển thị trên eyebrow tag (#eyebrow) trong mọi video
CHANNEL=DuyNQ

# 0 = skill dừng lại xác nhận từng bước | 1 = chạy tự động không hỏi
AUTO_CREATE_VIDEO=0
